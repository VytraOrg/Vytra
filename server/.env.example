# =========================
# Local Commerce App - Backend Environment Variables
# =========================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<appName>

# Server Port
PORT=5001

# JWT Configuration
JWT_SECRET=<your-strong-random-secret-here>
JWT_EXPIRES_IN=7d

# Redis (optional - caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Email Service (GoDaddy / Custom SMTP)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=support@vytra.co.in
SMTP_PASS=<password_created_for_support@vytra.co.in>
SMTP_FROM="Vytra" <support@vytra.co.in>

